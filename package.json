{
  "name": "pi-capstan",
  "version": "0.10.0",
  "type": "module",
  "description": "Controlled multi-agent coding pipeline for pi-coding-agent: plan-gated parallel subagents, Git-worktree isolation, DAG scheduling with path ownership, budgets, verification, merge, recovery.",
  "license": "MIT",
  "author": "Yongthyuan",
  "homepage": "https://github.com/Yongthyuan/pi-capstan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yongthyuan/pi-capstan.git"
  },
  "bugs": {
    "url": "https://github.com/Yongthyuan/pi-capstan/issues"
  },
  "files": [
    "index.ts",
    "src",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pi",
    "pi-coding-agent",
    "multi-agent",
    "capstan",
    "swarm",
    "subagents",
    "ai-agents",
    "llm",
    "orchestration",
    "git-worktree",
    "coding-agent"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:ci": "node --test --experimental-test-isolation=none --test-force-exit test/*.test.ts",
    "test:soak": "node scripts/soak.mjs",
    "check": "tsc --noEmit && node scripts/check-syntax.mjs",
    "test:native": "node scripts/native-smoke.mjs",
    "test:native:model": "node scripts/native-model-smoke.mjs",
    "test:native:plan": "node scripts/native-plan-smoke.mjs",
    "test:native:e2e": "node scripts/native-e2e-smoke.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.1",
    "@earendil-works/pi-tui": ">=0.84.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "22.19.19",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
